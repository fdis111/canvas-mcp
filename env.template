# Canvas API Configuration
# CANVAS_API_TOKEN is required for stdio and for MCP_AUTH_MODE=none.
# Leave it empty with MCP_AUTH_MODE=canvas: each user signs in with Canvas.
CANVAS_API_TOKEN=your_canvas_api_token_here
CANVAS_API_URL=https://your-institution.instructure.com/api/v1

# Optional Configuration
MCP_SERVER_NAME=canvas-api
DEBUG=false
API_TIMEOUT=30
CACHE_TTL=300
MAX_CONCURRENT_REQUESTS=10

# Development Configuration
LOG_LEVEL=INFO
LOG_API_REQUESTS=false

# Privacy and Security Configuration
ENABLE_DATA_ANONYMIZATION=true
ANONYMIZATION_DEBUG=false
LOG_REDACT_PII=true

# Audit Logging (Optional, disabled by default)
LOG_ACCESS_EVENTS=false
LOG_EXECUTION_EVENTS=false
AUDIT_LOG_DIR=

# Code Execution Sandbox (secure defaults, override to disable)
ENABLE_TS_SANDBOX=true
TS_SANDBOX_MODE=auto
TS_SANDBOX_BLOCK_OUTBOUND_NETWORK=true
TS_SANDBOX_ALLOWLIST_HOSTS=
# TS_SANDBOX_CPU_LIMIT is CPU seconds (best-effort locally, ulimit in container).
TS_SANDBOX_CPU_LIMIT=30
TS_SANDBOX_MEMORY_LIMIT_MB=512
TS_SANDBOX_TIMEOUT_SEC=120
TS_SANDBOX_CONTAINER_IMAGE=node:20-alpine

# HTTP MCP authentication (streamable-http transport only).
#   none   - no authentication; every caller acts as CANVAS_API_TOKEN.
#   canvas - OAuth 2.1: users sign in with their own Canvas account and every
#            tool call runs with that user's Canvas token (refreshed
#            automatically). Required for a public endpoint such as ChatGPT.
MCP_AUTH_MODE=none
MCP_PUBLIC_URL=https://your-mcp.example.com
# Canvas Developer Key (Admin > Developer Keys > + API Key). Its Redirect URI
# must be MCP_PUBLIC_URL + MCP_OAUTH_REDIRECT_PATH, e.g.
# https://your-mcp.example.com/auth/callback
CANVAS_OAUTH_CLIENT_ID=
CANVAS_OAUTH_CLIENT_SECRET=
# Optional: Canvas origin when it differs from CANVAS_API_URL without /api/v1.
CANVAS_BASE_URL=
# Only when the Developer Key enforces scopes; space-separated, e.g.
# url:GET|/api/v1/courses url:GET|/api/v1/users/:user_id/profile
CANVAS_OAUTH_SCOPES=
# Label shown in Canvas > Account > Settings > Approved Integrations.
CANVAS_OAUTH_PURPOSE=Canvas MCP
# Set true only if your Canvas instance supports PKCE on /login/oauth2/auth.
CANVAS_OAUTH_FORWARD_PKCE=false
# Signs MCP tokens and encrypts stored Canvas tokens. Use an independent,
# high-entropy value (e.g. `openssl rand -hex 32`) and keep it stable:
# changing it signs every user out.
MCP_JWT_SIGNING_KEY=
# Comma-separated MCP client redirect patterns (ChatGPT + local clients).
MCP_ALLOWED_CLIENT_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/connector/oauth/*,http://localhost:*,http://127.0.0.1:*
MCP_OAUTH_REDIRECT_PATH=/auth/callback
MCP_REQUIRE_AUTHORIZATION_CONSENT=true

# Optional Metadata
INSTITUTION_NAME=Your Institution Name
TIMEZONE=UTC
